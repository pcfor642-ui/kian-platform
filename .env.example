# Postgres connection (Supabase/Neon). DATABASE_URL is used at runtime,
# DIRECT_URL is used by Prisma Migrate (non-pooled connection).
DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Generate with: npx auth secret
AUTH_SECRET=""

# Optional: server-side only, used by the "text to question" AI helper.
# Leave empty to disable the feature.
ANTHROPIC_API_KEY=""

# Supabase Storage (file uploads: question images, chat attachments, lecture
# videos). SUPABASE_URL is the project URL; the service_role/secret key is
# server-only and must never be exposed to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
